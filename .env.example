# Stock Market Recommendation Environment Configuration Template
# Salin berkas ini ke .env dan isi dengan kunci API Anda sendiri.

# Kunci API Google Gemini untuk analisis narasi pasar harian (Morning Brief & Stock Insight)
GEMINI_API_KEY=your_gemini_api_key_here

# Nama model Gemini yang digunakan (Default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Secret Token untuk memicu eksekusi pipeline komputasi via API (X-Admin-Secret)
# Wajib diatur di server production sebelum dapat memicu /pipeline/run
ADMIN_PIPELINE_SECRET=your_secure_admin_secret_token_here

# Tingkat Suku Bunga Bebas Risiko (Bank Indonesia BI-Rate tahunan, contoh 0.06 untuk 6.00%)
RISK_FREE_RATE=0.06
